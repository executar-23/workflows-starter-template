{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executar-plan-mode.plan.schema.json",
  "title": "Executar Plan Mode Plan",
  "type": "object",
  "required": [
    "mode",
    "execution_approved",
    "objective",
    "scope",
    "phases",
    "quality_gates",
    "definition_of_done",
    "stop_state"
  ],
  "properties": {
    "target_agent": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "CODEX",
        "CLAUDE_CODE",
        "NEUTRAL",
        null
      ]
    },
    "mode": {
      "const": "PLAN"
    },
    "execution_approved": {
      "type": "boolean"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "objective",
          "actions",
          "output",
          "gate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "input": {
            "type": [
              "array",
              "string"
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "output": {
            "type": [
              "array",
              "string"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gate": {
            "type": "string"
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "definition_of_done": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "stop_state": {
      "const": "PLAN_READY"
    }
  }
}
